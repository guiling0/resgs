        "kb:links": "node scripts/kb-links.cjs",
        "kb:refs": "node scripts/kb-refs.cjs",
        "kb:mapping": "node scripts/kb-mapping.cjs",
        "kb:index": "node scripts/kb-index.cjs",
        "kb:check": "node scripts/kb-check.cjs",
        "kb:build": "node scripts/kb-build.cjs"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
